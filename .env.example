# ============================================
# UpMan Backend - Environment Configuration
# ============================================

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/database_name
MAX_DB_CONNECTIONS=10

# ============================================
# SERVER
# ============================================
PORT=8000

# ============================================
# SUPABASE AUTHENTICATION
# ============================================
# Get this from: Supabase Dashboard → Project Settings → API → Legacy JWT Secret tab
# For HS256 (legacy): Use the JWT secret string
# For ES256 (new ECC keys): The public key will be auto-fetched from JWKS endpoint
# NOTE: Your Supabase URL is auto-detected from DATABASE_URL
SUPABASE_JWT_SECRET=your-super-secret-jwt-secret-here

# Optional: Explicitly set Supabase URL (auto-detected if not set)
# SUPABASE_URL=https://yourproject.supabase.co

# ============================================
# SMTP EMAIL CONFIGURATION
# ============================================
# For Gmail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# For SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# For AWS SES:
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your-aws-smtp-username
# SMTP_PASS=your-aws-smtp-password

# From address for alert emails
ALERT_FROM=alerts@upman.io

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Log level - override default filtering
# Default: upman_backend=info,tower_http=info,axum=info,sqlx=warn,hyper=warn,reqwest=warn
# Options: trace, debug, info, warn, error
# Example for debug mode:
# RUST_LOG=upman_backend=debug,sqlx=debug
# RUST_LOG=info

# Worker configuration (adjust in code)
# Number of monitors to claim per batch: 50 (default)
# Worker polling interval: 3 seconds (default)
